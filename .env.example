# Copia este archivo como .env y ajusta los valores.
#
#   cp .env.example .env
#
# Docker Compose lee .env automáticamente. El archivo .env no se sube a Git
# porque contiene datos de la red de cada grupo.

# ---------------------------------------------------------------------------
# Modo local: central de prueba dentro del mismo compose.
# Funciona con: docker compose --profile local up --build
# ---------------------------------------------------------------------------
GROUP_NAME=g3
PUBLIC_URL=http://chat-g3:8000
CENTRAL_URL=http://central:9000

HOST_PORT=8001
CENTRAL_PORT=9000

# Segundo servidor del mismo grupo (perfil "pair").
GROUP_NAME_B=g3b
PUBLIC_URL_B=http://chat-g3-b:8000
HOST_PORT_B=8002

# ---------------------------------------------------------------------------
# Modo curso: reemplaza las dos URLs por las que el profesor pueda alcanzar.
# Ejemplo (cambia la IP por la de tu equipo en la red de la sala):
#
# PUBLIC_URL=http://192.168.1.50:8001
# CENTRAL_URL=http://192.168.1.10:9000
#
# Si el central del profesor está en Internet, usa su URL HTTPS.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Ajustes de resiliencia (opcionales).
# Con estos valores el central se marca caído tras 3 fallos cada 5 s (~15 s)
# y los reintentos empiezan en 1 s, duplicándose hasta un máximo de 30 s.
# ---------------------------------------------------------------------------
REGISTER_INTERVAL_SECONDS=10
HEARTBEAT_INTERVAL_SECONDS=5
HEARTBEAT_TIMEOUT_SECONDS=3
HEARTBEAT_FAILURES=3
REQUEST_TIMEOUT_SECONDS=5
RETRY_BASE_SECONDS=1
RETRY_MAX_SECONDS=30
LOG_LEVEL=INFO
